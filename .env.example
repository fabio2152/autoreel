# =====================================================================
# AutoReel — variables de entorno para desarrollo local
# ---------------------------------------------------------------------
# 1. Copia este archivo como .env en la raíz del repositorio (nunca subas .env).
# 2. Formato: CLAVE=valor, sin comillas y sin espacios alrededor del "=".
#    Usa "/" en las rutas. Evita "$" en los secretos.
# 3. Lo leen docker compose (Postgres) y el backend con el perfil dev.
# En producción (fase 8) estos valores vienen de AWS Secrets Manager.
# =====================================================================

# --- Fase 1: base de datos (docker compose) ---
POSTGRES_DB=autoreel
POSTGRES_USER=autoreel
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_PORT=5432

# --- Fase 1: conexión del backend ---
DB_URL=jdbc:postgresql://localhost:5432/autoreel
DB_USER=autoreel
DB_PASSWORD=cambia-esta-contrasena

# --- Fase 1: sesión ---
# Clave HMAC en base64 de al menos 32 bytes. Genérala con: openssl rand -base64 32
JWT_SECRET=reemplaza-por-el-resultado-de-openssl-rand-base64-32
# Duración de la sesión en horas (RN-08).
SESION_HORAS=8

# --- Fase 1: administrador inicial (sección 16) ---
# Solo se usa si todavía no existe un administrador. Mínimo 8 caracteres, con letras y números.
ADMIN_EMAIL=admin@autoreel.local
ADMIN_PASSWORD=cambia-esta-contrasena-1

# --- Fase 1: dirección del frontend (enlace que se entrega al cliente) ---
APP_URL=http://localhost:5173

# --- Fase 2: almacenamiento de archivos ---
# En local, SeaweedFS (docker compose) con API compatible con S3; en producción, Amazon S3.
# Estas credenciales son solo para SeaweedFS local: inventa cualquier par de valores.
AWS_REGION=us-east-1
AWS_S3_BUCKET=autoreel-dev
S3_ENDPOINT=http://localhost:8333
S3_PORT=8333
AWS_ACCESS_KEY_ID=autoreel-local
AWS_SECRET_ACCESS_KEY=cambia-este-secreto-local

# --- Fase 2: negocio de ejemplo del perfil dev (sección 16) ---
# Se crea al arrancar con el perfil dev si el correo no existe. Mínimo 8 caracteres, con letras y números.
DEMO_NEGOCIO_EMAIL=dulce.encanto@autoreel.local
DEMO_NEGOCIO_PASSWORD=cambia-esta-contrasena-2

# --- Fases 4 y 5: Google (Gemini para el guion y Veo para los clips) ---
# GEMINI_API_KEY=

# --- Fase 5: composición de video ---
# FFMPEG_PATH=ffmpeg

# --- Fase 6: Instagram (Meta) ---
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:5173/api/instagram/callback
# Clave para cifrar los tokens de Instagram en la base de datos (openssl rand -base64 32).
# TOKEN_CIFRADO_CLAVE=
