# Variables NO secretas del backend en la instancia EC2. Copia este archivo a /opt/autoreel/autoreel.env en el
# servidor y completa los valores. Nunca va al repositorio con datos reales.
#
# Los secretos (DB_USER, DB_PASSWORD, JWT_SECRET, ADMIN_EMAIL y ADMIN_PASSWORD) NO van aquí: están en el secreto
# autoreel/app de AWS Secrets Manager, que el backend lee al arrancar con el rol de la instancia.
SPRING_PROFILES_ACTIVE=aws
DB_URL=jdbc:postgresql://<endpoint-de-rds>:5432/autoreel
APP_URL=https://autoreel.sapps.lat
AWS_REGION=us-east-1
AWS_S3_BUCKET=<nombre-del-bucket-de-archivos>
SECRETOS_DE_ARRANQUE=autoreel/app
